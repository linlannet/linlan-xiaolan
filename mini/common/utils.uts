/**
 * 格式化日期
 * @param date 日期对象或时间戳
 * @param format 格式字符串，如 'yyyy-MM-dd HH:mm:ss'
 * @returns 格式化后的日期字符串
 */
export function formatDate(date: Date | number | string, format: string): string {
  if (typeof date === 'number') {
    date = new Date(date)
  } else if (typeof date === 'string') {
    date = new Date(date.replace(/-/g, '/'))
  }
  
  const options: Record<string, number> = {
    'M+': date.getMonth() + 1,
    'd+': date.getDate(),
    'H+': date.getHours(),
    'm+': date.getMinutes(),
    's+': date.getSeconds(),
    'q+': Math.floor((date.getMonth() + 3) / 3),
    'S': date.getMilliseconds()
  }
  
  if (/(y+)/.test(format)) {
    format = format.replace(RegExp.$1, (date.getFullYear() + '').substr(4 - RegExp.$1.length))
  }
  
  for (const key in options) {
    if (new RegExp(`(${key})`).test(format)) {
      format = format.replace(RegExp.$1, (
        RegExp.$1.length === 1
          ? options[key]
          : `00${options[key]}`.substr(('' + options[key]).length)
      ) as string)
    }
  }
  
  return format
}

/**
 * 获取当月第一天
 * @returns 当月第一天的日期对象
 */
export function getMonthFirstDay(): Date {
  const date = new Date()
  date.setDate(1)
  date.setHours(0, 0, 0, 0)
  return date
}

/**
 * 获取当月最后一天
 * @returns 当月最后一天的日期对象
 */
export function getMonthLastDay(): Date {
  const date = new Date()
  date.setMonth(date.getMonth() + 1)
  date.setDate(0)
  date.setHours(23, 59, 59, 999)
  return date
}

/**
 * 计算两个日期之间的天数
 * @param date1 日期1
 * @param date2 日期2
 * @returns 天数差
 */
export function getDaysBetween(date1: Date, date2: Date): number {
  const oneDayMs = 24 * 60 * 60 * 1000
  const msDiff = Math.abs(date2.getTime() - date1.getTime())
  return Math.round(msDiff / oneDayMs)
}

/**
 * 获取日期对应的星期几
 * @param date 日期对象
 * @returns 星期几（中文）
 */
export function getWeekDay(date: Date): string {
  const weekdays = ['日', '一', '二', '三', '四', '五', '六']
  return `星期${weekdays[date.getDay()]}`
}