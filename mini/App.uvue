<script lang="uts">
	let firstBackTime = 0
	export default {
		onLaunch: function () {
			
		},
		onShow: function () {
			
		},
		onHide: function () {
			
		},
		onLastPageBackPress: function () {
			
			if (firstBackTime == 0) {
				uni.showToast({
					title: '再按一次退出应用',
					position: 'bottom',
				})
				firstBackTime = Date.now()
				setTimeout(() => {
					firstBackTime = 0
				}, 2000)
			} else if (Date.now() - firstBackTime < 2000) {
				firstBackTime = Date.now()
				uni.exit()
			}
		},
		onExit: function () {
			
		}
	}
</script>

<style lang="scss">
	/*每个页面公共css */
	@import "@/common/fui-app.css";
	/*css基础布局样式，按需引入*/
	@import '@/components/firstui/fui-css/firstui.scss';
</style>