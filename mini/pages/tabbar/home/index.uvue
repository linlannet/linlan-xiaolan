<template>
	<view class="container">
		<tc-calendar :date="currentDate" :selected="selected" @monthSwitch="monthSwitch" @change="handleSelect" lunar />
		<!-- 明细列表 -->
		<fui-empty v-if="filteredRecords.length == 0" src="/static/images/component/empty/img_order_3x.png" title="暂无收支信息"
			:marginTop="64"></fui-empty>
		<view class="record-list" v-if="filteredRecords.length > 0">
			<view class="date-info">{{currentDate}}</view>
			<view class="record-item" v-for="record in filteredRecords" :key="record.id">
				<view class="record-icon">
					<image :src="record.icon" class="icon"></image>
				</view>
				<view class="record-info">
					<text class="record-name">{{ record.category }}</text>
					<text class="record-date">{{ record.name }}</text>
				</view>
				<text class="record-amount"
					:class="record.type === 'ZHICHU' ? 'ZHICHU' : 'SHOURU'">{{ record.amount > 0 ? '+' : '' }}{{ record.amount }}</text>
			</view>
		</view>
		<fui-footer text="Copyright © 2025 linlan.net"></fui-footer>

	</view>
</template>

<script>
	import { formatDate } from '@/common/utils.uts';
	import { getCheckRecords } from '@/api/modules/finance';
	import LoginUtils from '@/utils/login.uts'
	export default {
		data() {
			const today = new Date();
			const currentDate = formatDate(today, 'yyyy-MM-dd');

			return {
				today: today,
				currentDate: currentDate, // 设置今天的日期
				selected: [],
				// 模拟账单数据
				records: []
			}
		},
		computed: {
			filteredRecords() {
				return this.records ? this.records.filter(record => record.date === this.currentDate) : [];
			}
		},
		created() {
			this.selected = this.generateSelectedDates();
		},
        onShow(){
            this.getCheckRecordsRemote(this.today.getFullYear(),this.today.getMonth()+1)
        },
		methods: {
			generateSelectedDates() {
				const dailyAmounts = this.calculateDailyAmounts();
				// 获取records中的所有唯一日期并按降序排序
				const uniqueDates = [...new Set(this.records.map(record => record.date))].sort((a, b) => new Date(b) - new Date(a));

				return uniqueDates.map((dateStr, index) => {
					const amount = dailyAmounts[dateStr] || 0;
					return {
						date: dateStr,
						point: {
							position: 5,
							color: amount <= 0 ? '#19be6b' : '#fa3534'
						},
						info: amount >= 0 ? `+${amount.toFixed(2)}` : amount.toFixed(2),
						text: {
							size: 12,
							color: amount <= 0 ? '#19be6b' : '#fa3534'
						}
					};
				});
			},

			calculateDailyAmounts() {
				const dailyAmounts = {};
				this.records.forEach(record => {
					dailyAmounts[record.date] = (dailyAmounts[record.date] || 0) + record.amount;
				});
				return dailyAmounts;
			},

			// 日期点击事件
			handleSelect(e) {
				this.currentDate = e.fulldate;
				// 可以在这里添加日期点击后的处理逻辑
			},

			// 月份切换事件
			monthSwitch(e) {
				this.getCheckRecordsRemote(e.year,e.month)
			},
			// 获取账单记录
			async getCheckRecordsRemote(year:number,month:number){
				const loginResult = LoginUtils.checkLoginStatus()
				if (!loginResult.isLogin) {
					this.records = []
					return false
				}
				try {
					const startTime = formatDate(new Date(year, month, 1), 'yyyy-MM-dd');
					const endTime = formatDate(new Date(year, month + 1, 0, 23, 59, 59), 'yyyy-MM-dd');
					const res = await getCheckRecords();
					this.records = res.data.list.map(item => ({
						...item,
						name:item.description,
						category:item.name,
						date: formatDate(item.checkTime, 'yyyy-MM-dd'),
						amount: item.bizType === 'ZHICHU' ? -parseFloat(item.checkMoney) : parseFloat(item.checkMoney),
						type: item.bizType,
						icon: '/static/svg/record.svg' 
					}));
					this.selected = this.generateSelectedDates();
				} catch (err) {
			
				} finally {
					this.loading = false;
				}
			}
		},
		
		async onLoad() {
			// 设置沉浸式状态栏，让日历更好地占满屏幕
			if (uni.setNavigationBarColor) {
				uni.setNavigationBarColor({
					frontColor: '#000000',
					backgroundColor: '#ffffff'
				});
			}
			
		}
	}
</script>

<style lang="scss" scoped>
	.container {
		min-height: 100vh;
		background-color: #f5f5f5;
	}

	.record-list {
		margin: 30rpx 20rpx 16rpx;
		box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
		padding: 20rpx;
		background-color: #ffffff;
		border-radius: 16rpx;
	}

	.date-info {
		padding: 18rpx 0;
	}

	.record-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 24rpx;
		border-top: 1px solid #ebebeb;
	}

	.record-icon {
		width: 60rpx;
		height: 60rpx;
		margin-right: 20rpx;
	}

	.icon {
		width: 100%;
		height: 100%;
	}

	.record-info {
		flex: 1;
	}

	.record-name {
		font-size: 34rpx;
		color: #333;
		margin-bottom: 6rpx;
	}

	.record-date {
		font-size: 26rpx;
		color: #888888;
	}

	.record-amount {
		font-size: 32rpx;
		font-weight: bold;
	}

	.ZHICHU {
		color: #19be6b;
	}

	.SHOURU {
		color: #fa3534;
	}
</style>