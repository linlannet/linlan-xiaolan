  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #f5f7ff 100%);
  border-radius: 32rpx;
  padding: 44rpx;
  box-shadow: 0 16rpx 40rpx rgba(70, 92, 255, 0.15);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.header-card:hover {
  transform: translateY(-6rpx);
  box-shadow: 0 20rpx 48rpx rgba(70, 92, 255, 0.2);
}

.header-content {
  display: flex;
  align-items: center;
}

.header-icon {
  margin-right: 24rpx;
  background: linear-gradient(135deg, #465cff 0%, #7b61ff 100%);
  padding: 18rpx;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(70, 92, 255, 0.25);
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #222836;
  letter-spacing: 0.8rpx;
}

.add-btn {
  background: linear-gradient(135deg, #465cff 0%, #7b61ff 100%);
  color: #ffffff;
  border-radius: 44rpx;
  padding: 0 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(70, 92, 255, 0.25);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.add-btn:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 28rpx rgba(70, 92, 255, 0.3);
}

.add-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 6rpx 16rpx rgba(70, 92, 255, 0.2);
}

.account-list {
  padding: 32rpx;
}

.account-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.account-name {
  font-size: 32rpx;
  color: #333333;
}

.account-actions {
  display: flex;
  gap: 16rpx;
}

.edit-btn, .delete-btn {
  padding: 0 20rpx;
}
</style>