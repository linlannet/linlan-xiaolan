<template>
  <view class="fui-wrap">
    <!-- 头部区域 - 双层次渐变卡片设计 -->
    <view class="header-container">
      <view class="header-card">
        <view class="header-content">
          <fui-icon name="coupon-fill" size="44" color="#ffffff" class="header-icon" />
          <text class="header-title">账本管理</text>
        </view>
        <fui-button btnSize="mini" type="primary" :size="38" text="新增账本" @onclick="navigateToAddAccount" class="add-btn" />
      </view>
    </view>

    <!-- 账本列表 -->
    <view class="account-list">
      <view class="account-item" v-for="(account, index) in accounts" :key="index">
        <text class="account-name">{{ account.name }}</text>
        <view class="account-actions">
          <fui-button btnSize="mini" type="warning" :size="24" text="编辑" @onclick="handleEdit(index)" class="edit-btn" />
          <fui-button btnSize="mini" type="danger" :size="24" text="删除" @onclick="handleDelete(index)" class="delete-btn" />
        </view>
      </view>
    </view>
  </view>
</template>

<script>
export default {
  data() {
    return {
      accounts: []
    };
  },
  onLoad() {
    // 从本地存储加载账本数据
    this.accounts = uni.getStorageSync('accounts') || [];
  },
  methods: {
    navigateToAddAccount() {
      // 跳转到新增账本页面
      uni.navigateTo({ url: '/pages/tabbar/my/account/form-account' });
    },
    handleEdit(index) {
      // 编辑账本逻辑
      const account = this.accounts[index];
      uni.navigateTo({ url: `/pages/tabbar/my/account/form-account?id=${account.id}` });
    },
    handleDelete(index) {
      // 删除账本逻辑
      uni.showModal({
        title: '确认删除',
        content: '确定要删除这个账本吗？',
        success: (res) => {
          if (res.confirm) {
            this.accounts.splice(index, 1);
            // 同步更新本地存储
            uni.setStorageSync('accounts', this.accounts);
            uni.showToast({ title: '删除成功' });
          }
        }
      });
    }
  }
};
</script>

<style lang="scss">
