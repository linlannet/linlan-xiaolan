<template>
  <view class="fui-wrap">
    <!-- 头部区域 - 双层次渐变卡片设计 -->
    <view class="header-container">
      <view class="header-card">
        <view class="header-content">
          <fui-icon name="coupon-fill" size="44" color="#ffffff" class="header-icon" />
          <text class="header-title">心愿管理</text>
        </view>
        <fui-button btnSize="mini" type="primary" :size="38" text="新增心愿" @onclick="navigateToAddWish" class="add-btn" />
      </view>
    </view>

    <!-- 装饰性分隔线 -->
    <view class="header-divider"></view>

    <view class="wave-shape"></view>


    <!-- 心愿列表 -->
    <view class="wish-list">
      <view v-for="(wish, index) in wishList" :key="wish.id" class="wish-card">
        <view class="wish-status" :class="{'completed': wish.completed}"></view>
        <view class="wish-content">
          <view class="wish-header">
            <text class="wish-title">{{ wish.title }}</text>
          </view>
          <text class="wish-description">{{ wish.description }}</text>
          <view class="progress-section">
            <view class="progress-info">
              <text class="progress-label">完成进度</text>
              <text class="progress-value">{{ wish.progress }}%</text>
            </view>
            <view class="progress-container">
              <view class="progress-bar" :style="{ width: wish.progress + '%', backgroundColor: getProgressColor(wish.progress) }"></view>
            </view>
          </view>
          <view class="wish-actions">
            <view>
              <fui-button btnSize="mini" type="warning" :size="24" text="编辑" @onclick="handleEdit(index)" class="edit-btn" />
            </view>
            <view>
              <fui-button btnSize="mini" type="danger" :size="24" text="删除" @onclick="handleDelete(index)" class="delete-btn" />
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <!-- <fui-empty v-if="wishList.length === 0" text="暂无心愿计划" class="empty-state" /> -->
    </view>
  </view>
</template>

<script lang="uts">
import { ref, onMounted } from 'vue'
import fui from '@/common/fui-app.uts'

export default {
  setup() {
    // 心愿列表数据
    //const wishList = ref([])
    const wishList = ref(JSON.parse(uni.getStorageSync('wishes') || JSON.stringify([
      { id: 1, title: '学习Vue3', description: '掌握组合式API和响应式原理', completed: false, progress: 30 },
      { id: 2, title: '每周阅读一本书', description: '提升知识储备和思维能力', completed: true, progress: 100 },
      { id: 3, title: '坚持健身', description: '每周至少锻炼3次，每次1小时', completed: false, progress: 45 },
      { id: 4, title: '学习英语', description: '达到雅思6.5分水平', completed: false, progress: 20 }
    ])));
    // 从本地存储加载心愿数据
    const loadWishes = () => {
        const keys = uni.getStorageInfoSync().keys
        const wishes = []
        keys.forEach(key => {
            if (key.startsWith('wish_')) {
                wishes.push(uni.getStorageSync(key))
            }
        })
        wishList.value = wishes
    }

    // 新增心愿
    const navigateToAddWish = () => {
        uni.navigateTo({
            url: '/pages/tabbar/my/wish/add-wish'
        })
    }

    // 编辑心愿
    const handleEdit = (index) => {
        const wish = wishList.value[index]
        uni.navigateTo({
            url: `/pages/tabbar/my/wish/add-wish?id=${wish.id}`
        })
    }

    // 删除心愿
    const handleDelete = (index) => {
        const wish = wishList.value[index]
        fui.modal('确认删除', `确定要删除${wish.name}吗?`, (confirm) => {
            if (confirm) {
                uni.removeStorageSync(`wish_${wish.id}`)
                wishList.value.splice(index, 1)
                fui.toast('删除成功')
            }
        })
    }

    // 页面加载时获取数据
    const isAnimated = ref(false);

    onMounted(() => {
        // 页面加载动画
        setTimeout(() => {
            isAnimated.value = true;
        }, 100);
        //loadWishes()
    })

    // 计算心愿进度
    const getProgress = (wish) => {
      const target = Number(wish.targetAmount) || 0
      const initial = Number(wish.initialAmount) || 0
      return target > 0 ? Math.min(Math.round((initial / target) * 100), 100) : 0
    }

    // 计算进度条颜色
    const getProgressColor = (progress) => {
      if (progress >= 100) return '#4cd964';
      if (progress >= 60) return '#5ac8fa';
      if (progress >= 30) return '#ffcc00';
      return '#ff9500';
    }

    return {
        wishList,
        navigateToAddWish,
        handleEdit,
        handleDelete,
        getProgress,
        getProgressColor,
        isAnimated
    }
  }
}
</script>

