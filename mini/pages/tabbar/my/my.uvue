<template>
	<view class="fui-wrap">
		<!-- 背景装饰 -->
		<view class="background-decoration">
			<view class="decoration-shape shape1"></view>
			<view class="decoration-shape shape2"></view>
			<view class="decoration-shape shape3"></view>
		</view>
		<!-- VIP区域 -->
		<!-- <view class="vip-section">
			<view class="vip-content">
				<image class="vip-icon" src="/static/images/vip.png"></image>
				<view class="vip-text">
					<text class="vip-title">VIP</text>
				</view>
				<view class="vip-button" @click="openVipCenter">立即开通</view>
			</view>
		</view> -->
		<!-- 用户信息区域 -->
		<view class="user-section" v-if="isLogin">
			<view class="user-content">
				<view class="user-avatar">
					<image class="avatar-img" :src="userInfo.avatar" mode="aspectFill"></image>
				</view>
				<view class="user-info">
					<text class="user-name">{{ userInfo.nickname || '用户' }}</text>
					<text class="user-phone" v-if="userInfo.phoneNumber">{{ userInfo.phoneNumber }}</text>
					<text class="user-login-type" v-else>{{ userInfo.loginType === 'wechat' ? '微信用户' : '普通用户' }}</text>
				</view>
				<view class="user-actions">
					<view class="logout-btn" @click="logout">退出登录</view>
				</view>
			</view>
		</view>
		<!-- 未登录状态 -->
		<view class="user-section" v-else>
			<view class="user-content">
				<view class="user-avatar">
					<image class="avatar-img" src="/static/images/common/default-avatar.png" mode="aspectFill"></image>
				</view>
				<view class="user-info">
					<text class="user-name">未登录</text>
					<text class="user-login-hint">请登录以使用更多功能</text>
				</view>
				<view class="user-actions">
					<view class="login-btn" @click="navigateToLogin">立即登录</view>
				</view>
			</view>
		</view>

		<!-- 快捷功能区域 -->
		<view class="config-list">
			<uni-grid :column="4" :highlight="true" :show-border="false" >
				<uni-grid-item v-for="(item, index) in quickFunctions" :key="index">
					<view class="fui-grid__cell fui-padding" @click="handleFeatureClick(item.handler)">
						<image :src="item.icon" class="fui-icon__2x" mode="widthFix"></image>
						<text class="fui-text">{{ item.text }}</text>
					</view>
				</uni-grid-item>
			</uni-grid>
		</view>
		<!-- 功能列表区域2 - 个人配置相关 -->
		<view class="config-list">
			<fui-list-cell v-for="(item, index) in featureList" :key="index" :arrow="true" :bottomLeft="0">
				<view class="fui-list__item" @click="handleFeatureClick(item.handler)">
					<view class="fui-align__center">
						<image class="fui-list__icon" :src="item.icon" mode="widthFix"></image>
						<text class="fui-text">{{ item.text }}</text>
					</view>
				</view>
			</fui-list-cell>
		</view>
	</view>
</template>

<script>
	import fui from '@/common/fui-app.uts'
	import LoginUtils from '@/utils/login.uts'

	export default {
		data() {
			return {
				// 移除未使用的arrs数组
				isLogin: false,
				userInfo: {},
				// 快捷功能数据
				quickFunctions: [
					{ icon: '/static/images/index/light/icon_tabbar_3x.png', text: '分享好友', handler: 'shareApp' },
					{ icon: '/static/images/index/light/icon_tabbar_3x.png', text: '赞赏', handler: '' },
					{ icon: '/static/images/index/light/icon_tabbar_3x.png', text: '意见反馈', handler: '' },
					{ icon: '/static/images/index/light/icon_tabbar_3x.png', text: '我要合作', handler: '' }
				],
				// 功能列表数据
				featureList: [
					{ icon: '/static/images/index/light/icon_fab_3x.png', text: '个人信息', handler: '' },
					{ icon: '/static/images/index/light/icon_grid_3x.png', text: '心愿池配置', handler: '/pages/tabbar/my/wish/wish' },
					{ icon: '/static/images/index/light/icon_icon_3x.png', text: '记账配置', handler: '/pages/tabbar/my/account/account' },
					{ icon: '/static/images/index/light/icon_tabs_3x.png', text: '励志格言', handler: '/pages/tabbar/my/motivational-quotes/motivational-quotes' }
				]
			}
		},
		onShow() {
			this.checkLoginStatus()
		},
		methods: {
			// 添加通用点击处理方法
			handleFeatureClick(handlerName) {
				if (handlerName) {
					if(handlerName === 'shareApp'){
						this.shareApp()
						return
					}
					if (!this.isLogin) {
						this.navigateToLogin()
						return
					}
					uni.navigateTo({
						url: handlerName
					})
				}else{
					fui.toast('功能开发中')
				}
			},
			// 分享好友
			shareApp() {
				fui.toast('请点击右上角“...”,在微信中分享')
			},
			// 检查登录状态
			checkLoginStatus() {
				const loginResult = LoginUtils.checkLoginStatus()
				
				if (loginResult.isLogin) {
					this.isLogin = true
					this.userInfo = loginResult.userInfo
				} else {
					this.isLogin = false
					this.userInfo = {}
				}
			},
			
			// 退出登录
			logout() {
				fui.modal('提示', '确定要退出登录吗？', (confirm: boolean) => {
					if (confirm) {
						// 使用工具类退出登录
						LoginUtils.logout(() => {
							this.isLogin = false
							this.userInfo = {}
							fui.toast('已退出登录')
						})
					}
				})
			},
			// 跳转到登录页面
			navigateToLogin() {
				uni.navigateTo({
					url: '/pages/common/login/login'
				})
			},
			onLoad() {
				uni.showShareMenu({
					withShareTicket: true
				});
			}
		},
		onShareAppMessage() {
			return {
				 title: '分享小程序',
				 path: '/pages/tabbar/home/index',
				 imageUrl: '/static/images/logo.png'
			}
		}
	}
</script>

