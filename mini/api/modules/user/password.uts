// 移除 appConfig 导入
import request from '@/utils/request.uts';
import type { PasswordChangeParams } from '@/api/types/user.d.uts';

/**
 * 修改密码
 * @param params 密码修改参数
 */
export const changePassword = async (params: PasswordChangeParams): Promise<boolean> => {
  return request.post('/api/user/change-password', params); // 直接使用字符串路径
};

/**
 * 忘记密码（发送验证码）
 * @param username 用户名/手机号
 */
export const sendResetCode = async (username: string): Promise<boolean> => {
  return request.post('/api/auth/send-reset-code', {
    username
  }); // 直接使用字符串路径
};