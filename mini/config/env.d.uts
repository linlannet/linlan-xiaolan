/**
 * 环境变量类型定义
 */
export interface EnvConfig {
  /** API基础路径 */
  API_BASE_URL: string;
  /** 请求超时时间(ms) */
  REQUEST_TIMEOUT: number;
  /** 存储键名前缀 */
  STORAGE_KEY_PREFIX: string;
}
/**
 * 存储键名配置类型定义
 */
export interface StorageKeysConfig {
  token: string;
  userInfo: string;
  lastLoginTime: string;
}
/**
 * 应用配置类型定义
 */
export interface AppConfig {
  /** 环境配置 */
  env: EnvConfig;
  /** 存储键名配置 */
  storageKeys: StorageKeysConfig;
}