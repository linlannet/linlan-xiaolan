<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.linlan.www.comm.dao.CommSolutionDao">

    <resultMap id="BaseResultMap" type="net.linlan.www.comm.entity.CommSolution">
        <id column="ID" property="id" />
        <result column="TYPE" property="type" />
        <result column="TITLE" property="title" />
        <result column="DESCRIPTION" property="description" />
        <result column="ICON" property="icon" />
        <result column="SORT" property="sort" />
        <result column="STATUS" property="status" />
        <result column="DEL_FLAG" property="delFlag" />
        <result column="CREATE_TIME" property="createTime" />
        <result column="UPDATE_TIME" property="updateTime" />
    </resultMap>

    <sql id="Base_Column_List">
        ID, TYPE, TITLE, DESCRIPTION, ICON, SORT, STATUS, DEL_FLAG, CREATE_TIME, UPDATE_TIME
    </sql>

    <select id="getList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM COMM_SOLUTION
        WHERE DEL_FLAG = 0
        <if test="title != null and title != ''">
            AND TITLE LIKE CONCAT('%', #{title}, '%')
        </if>
        <if test="type != null">
            AND TYPE = #{type}
        </if>
        <if test="status != null">
            AND STATUS = #{status}
        </if>
        ORDER BY SORT ASC, CREATE_TIME DESC
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM COMM_SOLUTION
        WHERE ID = #{id} AND DEL_FLAG = 0
    </select>

    <insert id="save" parameterType="net.linlan.www.comm.entity.CommSolution" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO COMM_SOLUTION (TYPE, TITLE, DESCRIPTION, ICON, SORT, STATUS, DEL_FLAG, CREATE_TIME, UPDATE_TIME)
        VALUES (#{type}, #{title}, #{description}, #{icon}, #{sort}, #{status}, 0, NOW(), NOW())
    </insert>

    <update id="update" parameterType="net.linlan.www.comm.entity.CommSolution">
        UPDATE COMM_SOLUTION
        <set>
            <if test="type != null">TYPE = #{type},</if>
            <if test="title != null">TITLE = #{title},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="icon != null">ICON = #{icon},</if>
            <if test="sort != null">SORT = #{sort},</if>
            <if test="status != null">STATUS = #{status},</if>
            UPDATE_TIME = NOW()
        </set>
        WHERE ID = #{id}
    </update>

    <delete id="deleteById">
        UPDATE COMM_SOLUTION SET DEL_FLAG = 1 WHERE ID = #{id}
    </delete>

    <delete id="deleteByIds">
        UPDATE COMM_SOLUTION SET DEL_FLAG = 1 WHERE ID IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="getCount" resultType="int">
        SELECT COUNT(*) FROM COMM_SOLUTION WHERE DEL_FLAG = 0
        <if test="title != null and title != ''">
            AND TITLE LIKE CONCAT('%', #{title}, '%')
        </if>
    </select>

</mapper>
