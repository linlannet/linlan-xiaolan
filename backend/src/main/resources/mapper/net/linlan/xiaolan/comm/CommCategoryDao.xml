<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.xiaolan.comm.dao.CommCategoryDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.xiaolan.comm.entity.CommCategory" id="commCategoryMap">
        <id property="id" column="CATEGORY_ID"/>
        <result property="parentId" column="PARENT_ID"/>
        <result property="type" column="TYPE"/>
        <result property="bizType" column="BIZ_TYPE"/>
        <result property="name" column="NAME"/>
        <result property="code" column="CODE"/>
        <result property="content" column="CONTENT"/>
        <result property="status" column="STATUS"/>
        <result property="priority" column="PRIORITY"/>
        <result property="creatorId" column="CREATOR_ID"/>
        <result property="creatorName" column="CREATOR_NAME"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="lastTime" column="LAST_TIME"/>
        <result property="delFlag" column="DEL_FLAG"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="spare1" column="SPARE1"/>
        <result property="spare2" column="SPARE2"/>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="commCategoryMap">
        SELECT
CATEGORY_ID, PARENT_ID, TYPE, BIZ_TYPE, NAME, CODE, CONTENT, STATUS, PRIORITY, CREATOR_ID, CREATOR_NAME, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
        FROM XL_COMM_CATEGORY B
        WHERE B.CATEGORY_ID = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="commCategoryMap">
        SELECT
B.CATEGORY_ID, B.PARENT_ID, B.TYPE, B.BIZ_TYPE, B.NAME, B.CODE, B.CONTENT, B.STATUS, B.PRIORITY, B.CREATOR_ID, B.CREATOR_NAME, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION, B.SPARE1, B.SPARE2
        FROM XL_COMM_CATEGORY B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>

    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                <choose>
                    <when test='orderBy == 0'>
                        ORDER BY B.CREATE_TIME DESC
                    </when>
                    <when test='orderBy == 1'>
                        ORDER BY B.CREATE_TIME ASC
                    </when>
                    <when test='orderBy == 2'>
                        ORDER BY B.PRIORITY DESC
                    </when>
                    <when test='orderBy == 3'>
                        ORDER BY B.PRIORITY ASC
                    </when>
                    <otherwise>
                        ORDER BY B.CATEGORY_ID ASC
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY B.CATEGORY_ID DESC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象 -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test="id != null and id != ''">
            and B.CATEGORY_ID = #{id}
        </if>
        <if test="parentId != null and parentId != ''">
            and B.PARENT_ID = #{parentId}
        </if>
        <if test="type != null and type != ''">
            and B.TYPE = #{type}
        </if>
        <if test="bizType != null and bizType != ''">
            and B.BIZ_TYPE = #{bizType}
        </if>
        <if test="name != null and name != ''">
            and B.NAME = #{name}
        </if>
        <if test="code != null and code != ''">
            and B.CODE = #{code}
        </if>
        <if test="content != null and content != ''">
            and B.CONTENT = #{content}
        </if>
        <if test="status != null and status != ''">
            and B.STATUS = #{status}
        </if>
        <if test="creatorId != null and creatorId != ''">
            and B.CREATOR_ID = #{creatorId}
        </if>
        <if test="creatorName != null and creatorName != ''">
            and B.CREATOR_NAME = #{creatorName}
        </if>
        <choose>
            <when test="delFlag != null">
                AND B.DEL_FLAG = #{delFlag}
            </when>
            <otherwise>
                AND ( B.DEL_FLAG = 0 OR B.DEL_FLAG IS NULL)
            </otherwise>
        </choose>
        <if test="description != null and description != ''">
            and B.DESCRIPTION = #{description}
        </if>
        <if test="spare1 != null and spare1 != ''">
            and B.SPARE1 = #{spare1}
        </if>
        <if test="spare2 != null and spare2 != ''">
            and B.SPARE2 = #{spare2}
        </if>

        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>

            </when>
            <when test='_databaseId == "dm8"'>

            </when>
            <otherwise>

            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.xiaolan.comm.entity.CommCategory">
        INSERT INTO XL_COMM_CATEGORY
        (
CATEGORY_ID, PARENT_ID, TYPE, BIZ_TYPE, NAME, CODE, CONTENT, STATUS, PRIORITY, CREATOR_ID, CREATOR_NAME, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
        )
        VALUES
        (
#{id}, #{parentId}, #{type}, #{bizType}, #{name}, #{code}, #{content}, #{status}, #{priority}, #{creatorId}, #{creatorName}, #{createTime}, #{lastTime}, #{delFlag}, #{description}, #{spare1}, #{spare2}
        )
    </insert>

    <insert id="batchSave" parameterType="java.util.List">
        <choose>
            <when test='_databaseId == "mysql"'>
                INSERT INTO XL_COMM_CATEGORY
                (
CATEGORY_ID, PARENT_ID, TYPE, BIZ_TYPE, NAME, CODE, CONTENT, STATUS, PRIORITY, CREATOR_ID, CREATOR_NAME, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
                )
                VALUES
                <foreach collection="list" index="index" item="item" separator=",">
                    (
#{item.id}, #{item.parentId}, #{item.type}, #{item.bizType}, #{item.name}, #{item.code}, #{item.content}, #{item.status}, #{item.priority}, #{item.creatorId}, #{item.creatorName}, #{item.createTime}, #{item.lastTime}, #{item.delFlag}, #{item.description}, #{item.spare1}, #{item.spare2}
                    )
                </foreach>
            </when>
            <otherwise>
                <foreach collection="list" item="item" index="index" open="begin" close=";end;" separator=";">
                    INSERT INTO XL_COMM_CATEGORY
                    (
CATEGORY_ID, PARENT_ID, TYPE, BIZ_TYPE, NAME, CODE, CONTENT, STATUS, PRIORITY, CREATOR_ID, CREATOR_NAME, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
                    )
                    VALUES
                    (
#{item.id}, #{item.parentId}, #{item.type}, #{item.bizType}, #{item.name}, #{item.code}, #{item.content}, #{item.status}, #{item.priority}, #{item.creatorId}, #{item.creatorName}, #{item.createTime}, #{item.lastTime}, #{item.delFlag}, #{item.description}, #{item.spare1}, #{item.spare2}
                    )
                </foreach>
            </otherwise>
        </choose>
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.xiaolan.comm.entity.CommCategory">
        UPDATE XL_COMM_CATEGORY
        <set>
            <if test="parentId != null">PARENT_ID = #{parentId}, </if>
            <if test="type != null">TYPE = #{type}, </if>
            <if test="bizType != null">BIZ_TYPE = #{bizType}, </if>
            <if test="name != null">NAME = #{name}, </if>
            <if test="code != null">CODE = #{code}, </if>
            <if test="content != null">CONTENT = #{content}, </if>
            <if test="status != null">STATUS = #{status}, </if>
            <if test="priority != null">PRIORITY = #{priority}, </if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId}, </if>
            <if test="creatorName != null">CREATOR_NAME = #{creatorName}, </if>
            <if test="createTime != null">CREATE_TIME = #{createTime}, </if>
            <if test="lastTime != null">LAST_TIME = #{lastTime}, </if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag}, </if>
            <if test="description != null">DESCRIPTION = #{description}, </if>
            <if test="spare1 != null">SPARE1 = #{spare1}, </if>
            <if test="spare2 != null">SPARE2 = #{spare2}</if>
        </set>
        WHERE CATEGORY_ID = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <delete id="deleteById">
        DELETE FROM XL_COMM_CATEGORY
        WHERE CATEGORY_ID = #{value}
    </delete>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <delete id="deleteByIds">
        DELETE FROM XL_COMM_CATEGORY
        WHERE CATEGORY_ID IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM XL_COMM_CATEGORY B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- get list with dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <resultMap type="net.linlan.xiaolan.comm.dto.CommCategoryDto" extends="commCategoryMap" id="commCategoryDtoMap">

    </resultMap>

    <!-- get page with param input dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <select id="getPageDto" resultMap="commCategoryDtoMap">
        SELECT
B.CATEGORY_ID, B.PARENT_ID, B.TYPE, B.BIZ_TYPE, B.NAME, B.CODE, B.CONTENT, B.STATUS, B.PRIORITY, B.CREATOR_ID, B.CREATOR_NAME, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION, B.SPARE1, B.SPARE2
        FROM XL_COMM_CATEGORY B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>

    </select>

    <!-- get dto with input id，通过ID，查询dto对象 -->
    <select id="getDtoById" resultMap="commCategoryDtoMap">
        SELECT
B.CATEGORY_ID, B.PARENT_ID, B.TYPE, B.BIZ_TYPE, B.NAME, B.CODE, B.CONTENT, B.STATUS, B.PRIORITY, B.CREATOR_ID, B.CREATOR_NAME, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION, B.SPARE1, B.SPARE2
        FROM XL_COMM_CATEGORY B
        WHERE CATEGORY_ID = #{value}
    </select>

    <!-- 以下为新增特定的操作 -->


</mapper>
